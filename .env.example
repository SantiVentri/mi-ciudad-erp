NEXT_PUBLIC_SITE_URL=YOUR_DOMAIN
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Solo servidor: nunca con prefijo NEXT_PUBLIC_ (se mandaría al navegador)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ALLOWED_DEV_ORIGINS=YOUR_ALLOWED_DEV_ORIGINS

# Embotelladora: salida y regreso de las rutas (Google Maps > clic derecho > copiar coordenadas)
NEXT_PUBLIC_COMPANY_ADDRESS=COMPANY_ADDRESS
NEXT_PUBLIC_DEPOT_LATITUDE=COMPANY_LATITUDE
NEXT_PUBLIC_DEPOT_LONGITUDE=COMPANY_LONGITUDE

# OpenRouteService (gratis en https://openrouteservice.org/dev/#/signup). Solo servidor.
ORS_API_KEY=YOUR_ORS_API_KEY

# Nominatim pide identificar la app con un contacto
NOMINATIM_USER_AGENT="MiCiudadERP/1.0 (tu-email@dominio.com)"
